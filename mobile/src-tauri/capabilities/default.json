{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "default",
  "description": "Podstawowe uprawnienia aplikacji Bantrol na telefonie.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-fullscreen",
    "opener:default",
    "fs:default",
    {
      "identifier": "fs:allow-write-file",
      "allow": [{ "path": "$APPCACHE/**" }]
    },
    {
      "identifier": "http:default",
      "allow": [{ "url": "https://**" }]
    },
    "android-installer:default"
  ]
}
